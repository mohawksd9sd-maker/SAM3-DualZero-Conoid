\section{Candidate Functional Equation}

\[
\zeta_{\rm SAM3}(s) = \Phi(s) \, \zeta_{\rm SAM3}(1-s) + E(s),
\]
with
\[
\Phi(s) = \left( \frac{\ell_0}{2\pi} \right)^{s-1/2} \frac{\Gamma(s/2 + \gamma)}{\Gamma((1-s)/2 + \gamma)} \cdot \Xi_{\rm Reg_2}(s).
\]

\section{Control of the Error Term \(E(s)\)}

\begin{theorem}[Strong Decay on the Critical Line]
For \(|t| \ge 1\),
\[
\bigl|E\bigl(\tfrac12 + it\bigr)\bigr| \le \exp(-c \log^2 |t|).
\]
\end{theorem}

\begin{theorem}[No Creation or Cancellation of Zeros for Large \(|t|\)]
There exists \(T_0 > 0\) such that for \(|t| > T_0\), zeros of \(\zeta_{\rm SAM3}(s)\) on the critical line occur only where the main term \(\Phi(s) \zeta_{\rm SAM3}(1-s)\) vanishes.
\end{theorem}

