\begin{abstract}
We develop the core analytic machinery for the spectral zeta function \(\zeta_{\rm SAM3}(s)\) associated to the right-conoid spectral triple equipped with the Dual-Zero hyperreal regulator. We prove a graded cancellation lemma, derive the Poisson summation identity with controlled remainder, establish strong bounds on the error term \(E(s)\), and obtain a controlled functional equation on the critical line. These results provide a solid geometric foundation and strong control on zeros for large \(|t|\). We also discuss the current status toward a full proof of the Riemann Hypothesis.
\end{abstract}

\section{Precise Definition of the Regularized Trace}

The regularized spectral zeta function is defined as
\[
\zeta_{\rm SAM3}(s) := \operatorname{Tr}_{\rm Reg_2} \bigl( |D_\varepsilon|^{-s} \bigr),
\]
where the Dual-Zero regulator \(\operatorname{Reg}_2\) acts on the ordered sequence of absolute eigenvalues via symmetric pairwise ultrapower averaging:
\[
\operatorname{Reg}_2(f)(\{\lambda_n\}) = \mathrm{st}_\mathcal{U} \left( \frac{f(|\lambda_{2m}|) + f(|\lambda_{2m+1}|)}{2} \right).
\]

The heat-kernel representation (initially valid for \(\operatorname{Re}(s) > 2\)) is
\[
\zeta_{\rm SAM3}(s) = \frac{1}{\Gamma(s)} \int_0^\infty t^{s-1} K_{\rm Reg_2}(t) \, dt,
\]
where
\[
K_{\rm Reg_2}(t) = \sum_n \operatorname{Reg}_2 \bigl( e^{-t \lambda_n^2} \bigr).
\]

\section{Graded Cancellation Lemma}

\begin{lemma}[Exact Cancellation of Non-Invariant Modes]
Let \(\sigma: v \mapsto \pi - v\) be the reflection isometry of the right conoid. This induces an orthogonal \(\mathbb{Z}_2\)-grading \(\mathcal{H} = \mathcal{H}_+ \oplus \mathcal{H}_-\), where modes in the odd sector satisfy \(\sigma^*\phi_- = -\phi_-\).

Then the odd sector contributes exactly zero to the regularized heat kernel:
\[
K_{\rm Reg_2}(t)\Big|_{\mathcal{H}_-} = 0.
\]
\end{lemma}

