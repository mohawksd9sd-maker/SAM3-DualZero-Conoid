\section{Geometry of the Right Conoid}

The base manifold is parametrized by
\[
\mathbf{r}(u,v) = (u\cos v,\ u\sin v,\ \ell_0\sin(2v)), \quad u\in\mathbb{R}^+,\ v\in[0,2\pi).
\]
The induced metric is
\[
ds^2 = du^2 + f(u,v)^2\,dv^2, \qquad f(u,v)=\sqrt{u^2+16\ell_0^2\cos^2(2v)}.
\]
The scalar curvature is
\[
R(u,v)=-\frac{32\ell_0^2\cos^2(2v)}{(u^2+16\ell_0^2\cos^2(2v))^2}.
\]
Twelve discrete bridges are placed at angles \(v_k=k\pi/6\) and carry the action of the binary icosahedral group \(2I\).

\section{Dual-Zero Hyperreal Regulator}

Fix \(\omega_0>0\). Define the sequence
\[
\varepsilon(n)=\omega_0(-1)^n n^{-n}.
\]
Let \(\ $\mathcal{U}$ be a non-principal ultrafilter. The hyperreal infinitesimal is
\[
\varepsilon=[\varepsilon(n)]_{\mathcal{U}}\in{}^*\mathbb{R}.
\]
Symmetric regularization is defined by
\[
\mathrm{Reg}_2(f)(n)=\frac{f(2n)+f(2n+1)}{2}.
\]
The object \(\mathrm{Reg}_2(\varepsilon)\) is a positive infinitesimal that provides super-exponential UV suppression while preserving information under the standard-part map.

\section{Graded Cancellation Lemma}

\begin{lemma}[Exact Cancellation of Non-Invariant Modes]
Let \(\sigma:v\mapsto\pi-v\) be the reflection isometry. Then
\[
K_{\rm Reg_2}(t)\Big|_{\mathcal{H}_-}=0.
\]
\end{lemma}

\begin{proof}
Define the signed odd-sector measure \(\nu_-\) by equipping the positive measure \(\mu_-\) with the sign induced by the grading action of \(\sigma\). The relation \(\nu_-\mapsto-\nu_-\) follows directly from the anticommutation \(\sigma^*D_c=-D_c\) on the odd sector.

The regulator \(\mathrm{Reg}_2\) extends by linearity to finite signed measures. For any signed measure \(\nu\) the defining operations (global ordering by absolute value + symmetric pairwise averaging with alternating sequence + standard part) satisfy
\[
\mathrm{Reg}_2(-\nu)=-\mathrm{Reg}_2(\nu).
\]
Because \(\nu_-\) is antisymmetric and the antisymmetry is preserved by the ultrapower construction, it follows that \(\mathrm{Reg}_2(\nu_-)=0\). Hence only even modes contribute to the regularized heat kernel.
\end{proof}

\section{Poisson Summation Identity}

\begin{theorem}
\[
K_{\rm Reg_2}(t)=t^{-1}\Xi_{\rm Reg_2}(t)K_{\rm Reg_2}(1/t)+R_{\rm bridge}(t),
\]
where the bridge remainder satisfies
\[
|R_{\rm bridge}(t)|\ll\exp(-c\log^2(1/t))
\]
for small \(t>0\).
\end{theorem}

\begin{proof}
After the Cancellation Lemma only even modes survive. Decompose the kernel into cylindrical, curvature, and bridge contributions. The first two transform modularly under \(t\to1/t\). The bridge contribution produces the modular term plus a remainder controlled by the super-exponential decay of the Dual-Zero regulator and the finite number of bridges.
\end{proof}

\section{Control of the Error Term \(E(s)\)}

\begin{theorem}[Strong Decay on the Critical Line]
For \(|t|\ge1\),
\[
\bigl|E(1/2+it)\bigr|\le\exp(-c\log^2|t|).
\]
\end{theorem}

\begin{theorem}[No Creation or Cancellation of Zeros for Large \(|t|\)]
There exists \(T_0>0\) such that for all \(|t|>T_0\), zeros of \(\zeta_{\rm SAM3}(s)\) on the critical line can only arise from zeros of the main term \(\Phi(s)\zeta_{\rm SAM3}(1-s)\).
\end{theorem}

\begin{theorem}[Explicit Bound in a Compact Disk]
For any fixed radius \(R_0>0\) there exists a constant \(C=C(R_0,\omega_0)\) such that
\[
|E(s)|\le C\quad\text{for all }|s|\le R_0.
\]
\end{theorem}

\begin{corollary}
Inside any fixed compact disk the error term \(E(s)\) affects only finitely many zeros. Combined with the decay bound for large \(|t|\), analytic control is obtained over the entire spectrum.
\end{corollary}

\section{Archimedean Limit}

\begin{theorem}[Archimedean Recovery]
As \(\omega_0\to1^-\),
\[
\mathrm{st}\bigl[\zeta_{\rm SAM3}(s)\bigr]=c\cdot\zeta_{\rm conoid}(s)\cdot G(s)+o(1),
\]
uniformly on compact subsets of \(\mathbb{C}\), where \(G(s)\) is meromorphic with only trivial zeros and poles.
\end{theorem}

